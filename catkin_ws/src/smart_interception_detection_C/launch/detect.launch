<?xml version="1.0"?>
<!-- M2 检测（C++）：双路，各自订阅 /cam_left|right/image_raw，开两个检测窗口。
     source 自动判别：存在的文件走离线逐帧，否则当 ROS 话题名订阅（离线测试用 rosrun 传 source 参数）。
     相机物理位置不可再动。 -->
<launch>
  <arg name="start_camera" default="true"/>

  <include if="$(arg start_camera)"
           file="$(find smart_interception_camera)/launch/dual_cam.launch"/>

  <node name="ball_detector_left" pkg="smart_interception_detection_C" type="detector_node" output="screen">
    <rosparam command="load" file="$(find smart_interception_detection_C)/config/ball_hsv.yaml"/>
    <param name="source" value="/cam_left/image_raw"/>
  </node>

  <node name="ball_detector_right" pkg="smart_interception_detection_C" type="detector_node" output="screen">
    <rosparam command="load" file="$(find smart_interception_detection_C)/config/ball_hsv.yaml"/>
    <param name="source" value="/cam_right/image_raw"/>
  </node>
</launch>
