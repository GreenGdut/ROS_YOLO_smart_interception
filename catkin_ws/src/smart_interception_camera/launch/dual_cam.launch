<?xml version="1.0"?>
<!-- M1 标定完成：两路出帧 + camera_info（内参/畸变/双目矫正矩阵）。
     设备：/dev/video2 = HD 720P Webcam（物理左，cam_left）、/dev/video4 = USB Camera（物理右，cam_right）。
     标定基于 YUYV 1280x720，内参只绑分辨率不绑压缩格式，运行默认 MJPG 1280x720@30。
     重新标定时用: pixel_format:=yuyv framerate:=10
     ⚠ 相机物理位置不可再动，动了外参作废。
     usb_cam 把 image_raw 发在节点名命名空间下，话题 /cam_left/image_raw + /cam_right/image_raw -->
<launch>
  <arg name="left_device"  default="/dev/video2"/>
  <arg name="right_device" default="/dev/video4"/>
  <arg name="width"        default="1280"/>
  <arg name="height"       default="720"/>
  <arg name="framerate"    default="30"/>
  <arg name="pixel_format" default="mjpeg"/>

  <node name="cam_left" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device"     value="$(arg left_device)"/>
    <param name="io_method"        value="mmap"/>
    <param name="image_width"      value="$(arg width)"/>
    <param name="image_height"     value="$(arg height)"/>
    <param name="framerate"        value="$(arg framerate)"/>
    <param name="pixel_format"     value="$(arg pixel_format)"/>
    <param name="camera_name"      value="cam_left"/>
    <param name="camera_frame_id"  value="cam_left"/>
    <param name="camera_info_url"  value="file:///catkin_ws/src/smart_interception_camera/config/cam_left_camera_info.yaml"/>
  </node>

  <node name="cam_right" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device"     value="$(arg right_device)"/>
    <param name="io_method"        value="mmap"/>
    <param name="image_width"      value="$(arg width)"/>
    <param name="image_height"     value="$(arg height)"/>
    <param name="framerate"        value="$(arg framerate)"/>
    <param name="pixel_format"     value="$(arg pixel_format)"/>
    <param name="camera_name"      value="cam_right"/>
    <param name="camera_frame_id"  value="cam_right"/>
    <param name="camera_info_url"  value="file:///catkin_ws/src/smart_interception_camera/config/cam_right_camera_info.yaml"/>
  </node>
</launch>
